# Blokir eksekusi file PHP di folder uploads
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Hanya izinkan file gambar & dokumen lampiran pesanan
<FilesMatch ".*">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|doc|docx|zip|rar)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>